{
  "id": "7Ih_hCDD6dKyweYrMtXzx",
  "name": "Enterprise Alert",
  "nodes": [
    {
      "id": "webhook-trigger",
      "name": "EscalationWebhook",
      "type": "n8n-nodes-base.webhook",
      "parameters": {
        "httpMethod": "POST",
        "path": "escalation-alert",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "position": [240, 300]
    },
    {
      "id": "send-slack",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.MOCK_SLACK_URL }}/api/chat.postMessage",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {"name": "channel", "value": "#enterprise-oncall"},
            {"name": "text", "value": "=:rotating_light: *ENTERPRISE ALERT* — Ticket {{ $json.body.ticket_id }}\n*Account:* {{ $json.body.account_name }} ({{ $json.body.account_seat_count }} seats)\n*Issue:* {{ $json.body.category }}\n*Priority:* {{ $json.body.priority }}\n*Notes:* {{ $json.body.internal_notes }}"}
          ]
        }
      },
      "position": [520, 300]
    }
  ],
  "connections": {
    "EscalationWebhook": {"main": [[{"node": "Post to Slack", "type": "main", "index": 0}]]}
  },
  "active": true,
  "settings": {}
}
