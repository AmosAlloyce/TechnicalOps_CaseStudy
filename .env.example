# Environment variables for Canvasly TechOps local development
# Copy this file to .env and fill in your values
# NEVER commit .env to git — it is in .gitignore

# ─────────────────────────────────────────────
# LLM Configuration
# ─────────────────────────────────────────────

# LLM provider: groq (default) | ollama | bedrock | openai
LLM_PROVIDER=groq

# Groq API key — get yours free at https://console.groq.com
# If not set, system falls back to Ollama automatically
GROQ_API_KEY=your_groq_api_key_here

# Groq model (default: llama3-8b-8192)
GROQ_MODEL=llama3-8b-8192

# Ollama model for offline fallback (default: phi3-mini)
# Alternatives: gemma:2b (lighter, ~1.5GB)
OLLAMA_MODEL=phi3-mini

# OpenAI (only needed if LLM_PROVIDER=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=canvasly
DB_USER=canvasly
DB_PASSWORD=canvasly_dev

# ─────────────────────────────────────────────
# Service URLs (local Docker Compose)
# ─────────────────────────────────────────────
MOCK_ZENDESK_URL=http://localhost:8001
MOCK_SALESFORCE_URL=http://localhost:8002
MOCK_CANVASLY_ADMIN_URL=http://localhost:8003
MOCK_SLACK_URL=http://localhost:8004
WEBHOOK_RECEIVER_URL=http://localhost:8010
ENRICHMENT_URL=http://localhost:8011
TRIAGE_AGENT_URL=http://localhost:8012
ESCALATION_URL=http://localhost:8013
LOCAL_EVENT_BUS_URL=http://localhost:8020
OLLAMA_HOST=http://localhost:11434

# ─────────────────────────────────────────────
# Business Logic
# ─────────────────────────────────────────────
# Enterprise thresholds
ENTERPRISE_SEAT_THRESHOLD=100
ENTERPRISE_ARR_THRESHOLD=50000

# After-hours window (24h format, EST)
BUSINESS_HOURS_START=8
BUSINESS_HOURS_END=18
BUSINESS_HOURS_TZ=America/New_York

# Escalation re-page interval (minutes)
REPAGE_INTERVAL_MIN=30

# Set to true to force after-hours mode (demo/testing — escalation always fires)
FORCE_AFTER_HOURS=false

# ─────────────────────────────────────────────
# AWS (only needed for sam deploy — not for local Docker dev)
# ─────────────────────────────────────────────
# AWS_REGION=us-east-1
# AWS_PROFILE=default

# ─────────────────────────────────────────────
# n8n (workflow automation)
# n8n v1+ uses owner/member auth — basic auth removed
# ─────────────────────────────────────────────
N8N_DEFAULT_ADMIN_EMAIL=admin@canvasly.local
N8N_DEFAULT_ADMIN_PASSWORD=canvasly_dev

# ─────────────────────────────────────────────
# Grafana
# ─────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=canvasly_dev
